{
  "name": "handy-tools-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "lint": "eslint .",
    "test": "node --experimental-webstorage --localstorage-file=node_modules/.tmp-localstorage --test \"src/**/*.test.ts\"",
    "test:server": "node --env-file-if-exists=.env.local --test \"server/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.0",
    "cropperjs": "^1.6.2",
    "d3-geo": "^3.1.1",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^19.2.6",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.16.0",
    "topojson-client": "^3.1.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
