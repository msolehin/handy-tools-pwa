# Copy to .env.local for local dev. Both files are gitignored.
# Load with: node --env-file=.env.local server/index.ts

# Local Postgres 18. On Railway use ${{Postgres.DATABASE_URL}} instead.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/senangkit

# Google OAuth Web client id. Public value, not a secret — this flow has no client secret.
# Read by both the Vite build (inlined into the bundle) and the server.
# Leave unset and the app runs fine in guest mode; the account panel says sign-in isn't configured.
VITE_GOOGLE_CLIENT_ID=

# Set on Railway. Locally it stays unset so the session cookie works over plain http.
# NODE_ENV=production
